#!/bin/bash
set -u

container_name="fanmili-fnos"

is_healthy() {
  [ "$(docker inspect -f '{{.State.Running}}' "$container_name" 2>/dev/null)" = "true" ] || return 1
  docker exec "$container_name" node -e \
    "fetch('http://127.0.0.1:3000/api/setup/status').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" \
    >/dev/null 2>&1
}

case "${1:-}" in
  start|stop)
    exit 0
    ;;
  status)
    is_healthy && exit 0
    exit 3
    ;;
  log)
    exec docker logs --tail "${2:-100}" "$container_name"
    ;;
  *)
    exit 1
    ;;
esac
